# Copy to .env.local for local development, and set the same variable in the
# hosting provider's project settings for preview and production.

# Resend API key. Powers POST /api/waitlist: the visitor's confirmation email
# and the team notification to support@breakawayroping.pro.
#
# The sending domain breakawayroping.pro must be verified in Resend before either
# email will leave — an unverified domain makes every send fail, and the route
# will answer 502 rather than pretend the signup worked.
#
# Create at: https://resend.com/api-keys  (sending access is enough)
RESEND_API_KEY=
